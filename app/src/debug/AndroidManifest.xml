<?xml version="1.0" encoding="utf-8"?>
<!-- debug 빌드에만 합쳐지는 매니페스트. STEP 9 3D 테스트 화면을 런처 아이콘으로 띄운다. release 빌드에는 들어가지 않는다. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <activity
            android:name="com.dailyquest.app.debug.Avatar3dTestActivity"
            android:exported="true"
            android:label="DQ 3D 테스트"
            android:screenOrientation="portrait"
            android:taskAffinity="com.dailyquest.app.debug3d"
            android:theme="@style/Theme.DailyQuest">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- STEP 10 방 꾸미기 테스트 화면 -->
        <activity
            android:name="com.dailyquest.app.debug.RoomDecorTestActivity"
            android:exported="true"
            android:label="DQ 방 테스트"
            android:screenOrientation="portrait"
            android:taskAffinity="com.dailyquest.app.debugroom"
            android:theme="@style/Theme.DailyQuest">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
